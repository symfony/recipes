{
    "manifests": {
        "symfony/ux-ipx-image": {
            "manifest": {
                "env": {
                    "#1": "Options available at https://github.com/symfony/ux/blob/3.x/src/Image/src/Bridge/Ipx/README.md",
                    "#2": "",
                    "UX_IMAGE_DSN": "ipx://${IPX_HOST:-127.0.0.1}:${IPX_PORT:-3000}?secure=false"
                },
                "docker-compose": {
                    "compose.yaml": {
                        "services": [
                            "ipx:",
                            "  image: node:26-alpine",
                            "  command: npx --yes ipx@4 serve",
                            "  environment:",
                            "    IPX_FS_DIR: /srv/public",
                            "    IPX_ALLOWED_MODIFIERS: width,height,resize,fit,format,quality",
                            "  volumes:",
                            "    - ./public:/srv/public:ro"
                        ]
                    },
                    "compose.override.yaml": {
                        "services": [
                            "ipx:",
                            "  ports:",
                            "    - \"3000\""
                        ]
                    }
                },
                "post-install-output": [
                    "  * The recipe adds an <info>ipx</info> service to <info>compose.yaml</info>. <info>UX_IMAGE_DSN</info> in <info>.env</info> points at it over plain HTTP. With the Symfony CLI, <info>IPX_HOST</info> and <info>IPX_PORT</info> come from the port published in <info>compose.override.yaml</info>.",
                    "",
                    "  * IPX has no URL signing. <info>IPX_ALLOWED_MODIFIERS</info> in <info>compose.yaml</info> only allows the common modifiers. Add each extra operation you pass.",
                    "",
                    "  * <fg=blue>Read</> the documentation at <comment>https://github.com/symfony/ux/blob/3.x/src/Image/src/Bridge/Ipx/README.md</>"
                ]
            },
            "files": [],
            "ref": "ba2064ebb36e3b9dd6f3a36929dac57e2e3238d8"
        }
    }
}
