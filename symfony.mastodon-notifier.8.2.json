                        "target": "    chatter_transports:",
                        "content": "        mastodon: '%env(MASTODON_DSN)%'"
                    }
                ],
                "env": {
                    "#1": "MASTODON_DSN=mastodon://ACCESS_TOKEN@HOST"
                },
                "conflict": {
                    "symfony/framework-bundle": "<8.2"
                }
            },
