{
    "manifests": {
        "symfonycasts/sass-bundle": {
            "manifest": {
                "bundles": {
                    "Symfonycasts\\SassBundle\\SymfonycastsSassBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/",
                    "assets/": "assets/"
                },
                "gitignore": [
                    "/%PUBLIC_DIR%/assets/"
                ],
                "add-lines": [
                    {
                        "requires": "symfony/asset-mapper",
                        "file": "config/packages/asset_mapper.yaml",
                        "position": "after_target",
                        "target": "        missing_import_mode: strict",
                        "content": "        excluded_patterns: ['**/assets/styles/*/_*.scss']"
                    },
                    {
                        "requires": "symfony/asset-mapper",
                        "file": "config/packages/asset_mapper.yaml",
                        "position": "after_target",
                        "target": "        # The paths to make available to the asset mapper.",
                        "content": "        excluded_patterns: ['**/assets/styles/*/_*.scss']"
                    },
                    {
                        "requires": "symfony/asset-mapper",
                        "file": "config/packages/asset_mapper.yaml",
                        "position": "after_target",
                        "warn_if_missing": true,
                        "target": "asset_mapper:",
                        "content": "    excluded_patterns: ['**/assets/styles/*/_*.scss']"
                    },
                    {
                        "file": ".symfony.local.yaml",
                        "content": "    # Watch and build Sass files\n    sass:\n        cmd: ['symfony', 'console', 'sass:build', '--watch']",
                        "position": "after_target",
                        "target": "workers:",
                        "warn_if_missing": true
                    }
                ],
                "conflict": {
                    "symfony/asset-mapper": "<6.3",
                    "symfony/framework-bundle": "<8.2"
                }
            },
            "files": {
                "assets/styles/app.scss": {
                    "contents": [
                        "// add your SASS styles in this file",
                        ""
                    ],
                    "executable": false
                },
                "config/packages/symfonycasts_sass.yaml": {
                    "contents": [
                        "symfonycasts_sass:",
                        "    root_sass:",
                        "        - 'assets/styles/app.scss'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "caa1f77e781d87c62ac01a7bcac74737f246db89"
        }
    }
}
