{
    "manifests": {
        "symfony/ux-css": {
            "manifest": {
                "bundles": {
                    "Symfony\\UX\\Css\\UXCssBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "conflict": {
                    "symfony/flex": "<1.20.0 || >=2.0.0,<2.3.0",
                    "symfony/framework-bundle": "<8.2"
                },
                "add-lines": [
                    {
                        "file": "assets/styles/app.css",
                        "content": "@layer reset, base, tokens, components, utilities;\n\n@import '../../var/ux_css/styles.css';\n",
                        "position": "top",
                        "warn_if_missing": true
                    }
                ],
                "post-install-output": [
                    "  * Style your templates with tokens from <comment>config/packages/ux_css.yaml</>:",
                    "",
                    "      <div class=\"{{ css({ color: 'fg', bg: 'bg', p: '4' }) }}\">",
                    "",
                    "  * The CSS is written to <comment>var/ux_css/styles.css</> and imported from",
                    "    <comment>assets/styles/app.css</>. Run <info>php bin/console cache:warmup</>",
                    "    before building your assets in production.",
                    "",
                    "  * <fg=blue>Commit</> <comment>config/reference_css.php</>: editors read it to complete css() hashes.",
                    "",
                    "  * <fg=blue>Read</> the documentation at <comment>https://symfony.com/bundles/ux-css/current/index.html</>"
                ]
            },
            "files": {
                "config/packages/ux_css.yaml": {
                    "contents": [
                        "# yaml-language-server: $schema=../schema.json",
                        "ux_css:",
                        "    # A CSS reset in the \"reset\" layer, like Panda CSS; it removes the default",
                        "    # styles of the browser, such as heading sizes and list bullets",
                        "    # https://symfony.com/bundles/ux-css/current/preflight.html",
                        "    # preflight: true",
                        "",
                        "    # The default tokens of Panda CSS: colors, spacing, sizes, radii, font sizes,",
                        "    # font weights, line heights, letter spacings, fonts, shadows, borders,",
                        "    # blurs, aspect ratios, animations, durations and easings",
                        "    # https://symfony.com/bundles/ux-css/current/tokens.html#default-tokens",
                        "    default_tokens: panda",
                        "",
                        "    # Your own values, by category, added to the default ones or replacing them",
                        "    # https://symfony.com/bundles/ux-css/current/token-categories.html",
                        "    tokens:",
                        "        colors:",
                        "            brand: 'oklch(0.55 0.2 260)'",
                        "",
                        "    # Names for other tokens; a value with \"base\" changes with a condition",
                        "    # https://symfony.com/bundles/ux-css/current/tokens.html#semantic-tokens",
                        "    semantic_tokens:",
                        "        colors:",
                        "            primary: '{colors.brand}'",
                        "            fg: { base: '{colors.gray.900}', _osDark: '{colors.gray.50}' }",
                        "            bg: { base: '{colors.white}', _osDark: '{colors.gray.950}' }",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "31750443a5d0ce081b9b7feed528545cdb34b00b"
        }
    }
}
