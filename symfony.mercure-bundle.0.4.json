{
    "manifests": {
        "symfony/mercure-bundle": {
            "manifest": {
                "bundles": {
                    "Symfony\\Bundle\\MercureBundle\\MercureBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "env": {
                    "#1": "See https://symfony.com/doc/current/mercure.html#configuration",
                    "#2": "The URL of the Mercure hub, used by the app to publish updates (can be a local URL)",
                    "MERCURE_URL": "https://example.com/.well-known/mercure",
                    "#3": "The public URL of the Mercure hub, used by the browser to connect",
                    "MERCURE_PUBLIC_URL": "https://example.com/.well-known/mercure",
                    "#4": "The secret used to sign the JWTs",
                    "MERCURE_JWT_SECRET": "!ChangeThisMercureHubJWTSecretKey!"
                },
                "docker-compose": {
                    "docker-compose.yml": {
                        "services": [
                            "mercure:",
                            "  image: dunglas/mercure",
                            "  restart: unless-stopped",
                            "  environment:",
                            "    # Uncomment the following line to disable HTTPS,",
                            "    #SERVER_NAME: ':80'",
                            "    MERCURE_PUBLISHER_JWT_KEY: '!ChangeThisMercureHubJWTSecretKey!'",
                            "    MERCURE_SUBSCRIBER_JWT_KEY: '!ChangeThisMercureHubJWTSecretKey!'",
                            "    # protocol_version_compatibility accepts the Mercure 0.x tokens issued by this bundle version, remove it after upgrading to symfony/mercure-bundle 0.6",
                            "    # Set the URL of your Symfony project (without trailing slash!) as value of the cors_origins directive",
                            "    MERCURE_EXTRA_DIRECTIVES: |",
                            "      protocol_version_compatibility 8",
                            "      cors_origins http://127.0.0.1:8000",
                            "  volumes:",
                            "    - mercure_data:/data",
                            "    - mercure_config:/config"
                        ],
                        "volumes": [
                            "mercure_data:",
                            "mercure_config:"
                        ]
                    },
                    "docker-compose.override.yml": {
                        "services": [
                            "mercure:",
                            "  ports:",
                            "    - \"80\"",
                            "  environment:",
                            "    # Replaces MERCURE_EXTRA_DIRECTIVES from docker-compose.yml, keep the other directives in sync",
                            "    # The playground directive enables the development mode (anonymous subscribers, debug UI)",
                            "    MERCURE_EXTRA_DIRECTIVES: |",
                            "      protocol_version_compatibility 8",
                            "      playground",
                            "      cors_origins http://127.0.0.1:8000",
                            "    # Development only: trust the X-Forwarded-* headers sent from private networks, e.g. by \"symfony serve --proxy-mercure\"",
                            "    GLOBAL_OPTIONS: |",
                            "      servers {",
                            "        trusted_proxies static private_ranges",
                            "      }"
                        ]
                    }
                }
            },
            "files": {
                "config/packages/mercure.yaml": {
                    "contents": [
                        "mercure:",
                        "    hubs:",
                        "        default:",
                        "            url: '%env(default::MERCURE_URL)%'",
                        "            public_url: '%env(default::MERCURE_PUBLIC_URL)%'",
                        "            jwt:",
                        "                secret: '%env(MERCURE_JWT_SECRET)%'",
                        "                publish: '*'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "9f9016974c85645f3a2427c6d904bf28dfb7818c"
        }
    }
}
