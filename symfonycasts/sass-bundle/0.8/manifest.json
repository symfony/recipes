{
    "bundles": {
        "Symfonycasts\\SassBundle\\SymfonycastsSassBundle": ["all"]
    },
    "copy-from-recipe": {
        "config/": "%CONFIG_DIR%/",
        "assets/": "assets/"
    },
    "aliases": ["symfonycasts_sass"],
    "gitignore": [
        "/%PUBLIC_DIR%/assets/"
    ],
    "add-lines": [
        {
            "requires": "symfony/asset-mapper",
            "file": "config/packages/asset_mapper.yaml",
            "position": "after_target",
            "target": "        missing_import_mode: strict",
            "content": [
                "        excluded_patterns: ['**/assets/styles/*/_*.scss']"
            ]
        },
        {
            "requires": "symfony/asset-mapper",
            "file": "config/packages/asset_mapper.yaml",
            "position": "after_target",
            "target": "        # The paths to make available to the asset mapper.",
            "content": [
                "        excluded_patterns: ['**/assets/styles/*/_*.scss']"
            ]
        },
        {
            "requires": "symfony/asset-mapper",
            "file": "config/packages/asset_mapper.yaml",
            "position": "after_target",
            "warn_if_missing": true,
            "target": "asset_mapper:",
            "content": [
                "    excluded_patterns: ['**/assets/styles/*/_*.scss']"
            ]
        },
        {
            "file": ".symfony.local.yaml",
            "content": [
                "    # Watch and build Sass files",
                "    sass:",
                "        cmd: ['symfony', 'console', 'sass:build', '--watch']"
            ],
            "position": "after_target",
            "target": "workers:",
            "warn_if_missing": true
        }
    ],
    "conflict": {
        "symfony/asset-mapper": "<6.3",
        "symfony/framework-bundle": "<8.2"
    }
}
