                        "target": "    platform:",
                        "requires": "symfony/ai-bundle",
                        "content": "        aimlapi:\n            api_key: '%env(AIMLAPI_API_KEY)%'"
                    }
                ],
                "env": {
                    "AIMLAPI_API_KEY": ""
                }
            },
            "files": [],
