                        "warn_if_missing": true,
                        "target": "    chatter_transports:",
                        "content": "        microsoftteams: '%env(MICROSOFT_TEAMS_DSN)%'"
                    }
                ],
                "env": {
                    "#1": "MICROSOFT_TEAMS_DSN=microsoftteams://default/HOSTPATH"
                },
                "conflict": {
                    "symfony/framework-bundle": "<8.2"
                }
            },
            "files": [],
