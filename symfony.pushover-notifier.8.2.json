{
    "manifests": {
        "symfony/pushover-notifier": {
            "manifest": {
                "add-lines": [
                    {
                        "file": "config/packages/notifier.yaml",
                        "position": "after_target",
                        "target": "        texter_transports:",
                        "content": "            pushover: '%env(PUSHOVER_DSN)%'"
                    },
                    {
                        "file": "config/packages/notifier.yaml",
                        "position": "after_target",
