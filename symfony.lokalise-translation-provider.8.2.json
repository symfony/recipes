                    },
                    {
                        "file": "config/packages/translation.yaml",
                        "position": "after_target",
                        "target": "    providers:",
                        "content": "        lokalise: { dsn: '%env(LOKALISE_DSN)%' }"
                    }
                ],
                "env": {
                    "#1": "LOKALISE_DSN=lokalise://PROJECT_ID:API_KEY@default"
                },
