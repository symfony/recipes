{
    "manifests": {
        "symfony/ai-azure-search-store": {
            "manifest": {
                "add-lines": [
                    {
                        "file": "%CONFIG_DIR%/packages/ai.yaml",
                        "position": "after_target",
                        "warn_if_missing": true,
                        "target": "    store:",
                        "requires": "symfony/ai-bundle",
                        "content": "        azuresearch:\n            default:\n                endpoint: '%env(AZURE_SEARCH_ENDPOINT)%'\n                api_key: '%env(AZURE_SEARCH_API_KEY)%'\n                api_version: '2024-07-01'"
                    }
                ],
                "env": {
                    "#1": "AZURE_SEARCH_ENDPOINT=",
                    "#2": "AZURE_SEARCH_API_KEY="
                }
            },
            "files": [],
            "ref": "d4c1223386013b8039163f289962c7d3f5764c26"
        }
    }
}
