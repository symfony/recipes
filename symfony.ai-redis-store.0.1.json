{
    "manifests": {
        "symfony/ai-redis-store": {
            "manifest": {
                "add-lines": [
                    {
                        "file": "%CONFIG_DIR%/packages/ai.yaml",
                        "position": "after_target",
                        "warn_if_missing": true,
                        "target": "    store:",
                        "requires": "symfony/ai-bundle",
                        "content": "        redis:\n            default:\n                dsn: '%env(REDIS_DSN)%'"
                    }
                ],
                "env": {
                    "#1": "REDIS_DSN=redis://localhost:6379"
                }
            },
            "files": [],
            "ref": "4b23718c72ec0e1887e083e68c16a872f0b5f9d0"
        }
    }
}
