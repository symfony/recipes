                        "content": "        isendpro: '%env(ISENDPRO_DSN)%'"
                    }
                ],
                "env": {
                    "#1": "ISENDPRO_DSN=isendpro://ACCOUNT_KEY_ID@default?from=FROM&no_stop=NO_STOP&sandbox=SANDBOX"
                },
                "conflict": {
                    "symfony/framework-bundle": "<8.2"
                }
            },
