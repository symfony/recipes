{
    "add-lines": [
        {
            "file": "%CONFIG_DIR%/packages/ai.yaml",
            "position": "after_target",
            "warn_if_missing": true,
            "target": "    store:",
            "requires": "symfony/ai-bundle",
            "content": [
                "        pinecone:",
                "            default:",
                "                api_key: '%env(PINECONE_API_KEY)%'",
                "                index_host: '%env(PINECONE_INDEX_HOST)%'"
            ]
        }
    ],
    "env": {
        "#1": "PINECONE_API_KEY=",
        "#2": "PINECONE_INDEX_HOST="
    }
}
