            "target": "    chatter_transports:",
            "content": [
                "        fakechat+email: '%env(FAKE_CHAT_DSN)%'"
            ]
        }
    ],
    "env": {
        "#1": "FAKE_CHAT_DSN=fakechat+email://default?to=TO&from=FROM"
    },
    "conflict": {
        "symfony/framework-bundle": "<8.2"
    }
}
