{
    "add-lines": [
        {
            "file": "%CONFIG_DIR%/packages/ai.yaml",
            "position": "after_target",
            "warn_if_missing": true,
            "target": "    store:",
            "requires": "symfony/ai-bundle",
            "content": [
                "        supabase:",
                "            default:",
                "                url: '%env(SUPABASE_URL)%'",
                "                api_key: '%env(SUPABASE_API_KEY)%'"
            ]
        }
    ],
    "env": {
        "#1": "SUPABASE_URL=",
        "#2": "SUPABASE_API_KEY="
    }
}
