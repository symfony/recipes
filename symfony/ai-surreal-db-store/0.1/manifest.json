{
    "add-lines": [
        {
            "file": "%CONFIG_DIR%/packages/ai.yaml",
            "position": "after_target",
            "warn_if_missing": true,
            "target": "    store:",
            "requires": "symfony/ai-bundle",
            "content": [
                "        surrealdb:",
                "            default:",
                "                dsn: '%env(SURREALDB_DSN)%'",
                "                namespace: 'default'",
                "                database: 'default'"
            ]
        }
    ],
    "env": {
        "#1": "SURREALDB_DSN=http://localhost:8000"
    }
}
