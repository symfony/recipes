            "content": [
                "        linkedin: '%env(LINKEDIN_DSN)%'"
            ]
        }
    ],
    "env": {
        "#1": "LINKEDIN_DSN=linkedin://token:user-id@default"
    },
    "conflict": {
        "symfony/framework-bundle": "<8.2"
    }
}
