{
    "manifests": {
        "symfony/vonage-notifier": {
            "manifest": {
                "add-lines": [
                    {
                        "file": "config/packages/notifier.yaml",
                        "position": "after_target",
                        "target": "        texter_transports:",
                        "content": "            vonage: '%env(VONAGE_DSN)%'"
                    },
                    {
                        "file": "config/packages/notifier.yaml",
                        "position": "after_target",
                        "warn_if_missing": true,
                        "target": "    texter_transports:",
                        "content": "        vonage: '%env(VONAGE_DSN)%'"
                    }
                ],
                "env": {
                    "#1": "VONAGE_DSN=vonage://KEY:SECRET@default?from=FROM"
                },
                "conflict": {
                    "symfony/framework-bundle": "<8.2"
                }
            },
            "files": [],
            "ref": "e6e8fbf5d3bc47b456aae32fc55900d7fbf59542"
        }
    }
}
